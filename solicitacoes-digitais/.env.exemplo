# Configuração por ambiente da API de Solicitações Digitais (copie para .env e preencha).
# Nunca versione o .env: ele guarda segredos.

# ---- ambiente: desenvolvimento | teste | homologacao | producao
# Fora de desenvolvimento e teste, SD_SEGREDO é obrigatório (32+ caracteres). Em produção o banco precisa ser
# PostgreSQL e o SMTP fora da própria máquina precisa de starttls ou ssl.
SD_AMBIENTE=producao
# gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SD_SEGREDO=
# endereço pelo qual os usuários abrem o sistema (vai nos links dos e-mails)
SD_URL_PUBLICA=https://solicitacoes.exemplo.gov.br

# ---- banco (o docker-compose monta SD_BANCO_URL a partir destes)
POSTGRES_DB=solicitacoes
POSTGRES_USER=sd
POSTGRES_PASSWORD=
# fora do docker-compose, informe a URL completa:
# SD_BANCO_URL=postgresql+psycopg://sd:senha@localhost:5432/solicitacoes

# ---- sessão e senhas
SD_TOKEN_MINUTOS=60
SD_PBKDF2_ITERACOES=600000

# ---- anexos
SD_ANEXOS_DIR=/dados/anexos
SD_ANEXO_MAX_MB=10
SD_ANEXOS_POR_SOLICITACAO=20

# ---- e-mail (SMTP). Sem SD_SMTP_HOST nada é enviado e as mensagens esperam na caixa de saída.
SD_SMTP_HOST=
SD_SMTP_PORTA=587
SD_SMTP_SEGURANCA=starttls
SD_SMTP_USUARIO=
SD_SMTP_SENHA=
SD_SMTP_REMETENTE=nao-responda@exemplo.gov.br
SD_SMTP_TIMEOUT=15
# intervalo, em segundos, do serviço que envia a caixa de saída
SD_ENVIO_INTERVALO=60

# ---- publicação (docker-compose)
# porta publicada da API; por padrão só na própria máquina (atrás de um proxy HTTPS)
SD_PORTA_PUBLICA=127.0.0.1:8000
SD_VERSAO_IMAGEM=local
