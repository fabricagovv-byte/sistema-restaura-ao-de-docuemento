# Copie para .env e ajuste. Variáveis com prefixo LIC_.
LIC_JWT_SEGREDO=gere-um-segredo-longo-e-aleatorio-com-mais-de-32-caracteres
LIC_EXECUCAO=celery

# IA (Claude). Sem a chave, a análise traz só os dados oficiais estruturados.
ANTHROPIC_API_KEY=
LIC_IA_MODELO=claude-opus-5-5
LIC_IA_ESFORCO=high

# Portal da Transparência (chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email)
LIC_TRANSPARENCIA_CHAVE=
LIC_TRANSPARENCIA_ORGAOS=

# Alertas por e-mail
LIC_SMTP_HOST=
LIC_SMTP_PORTA=587
LIC_SMTP_USUARIO=
LIC_SMTP_SENHA=
LIC_SMTP_REMETENTE=

# Alertas por WhatsApp Business (Cloud API da Meta)
LIC_WHATSAPP_TOKEN=
LIC_WHATSAPP_PHONE_ID=
LIC_WHATSAPP_TEMPLATE=

# Perfil da empresa (pesa na aderência)
LIC_CATEGORIAS_PRIORITARIAS=digitalizacao,indexacao,ged,triagem,guarda,desenvolvimento,fabrica_software,manutencao_software,sustentacao,dados,ia
LIC_INTERVALO_MONITORAMENTO_MIN=15

# Opcionais
# LIC_OPENSEARCH_URL=http://opensearch:9200
# LIC_EMBEDDINGS_MODELO=paraphrase-multilingual-MiniLM-L12-v2
